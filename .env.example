# ==============================================================================
# Commerce Insights - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root or copy individual sections to
# backend/.env and frontend/.env as needed by your workflow.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="Commerce Insights API"
ENVIRONMENT="development"              # Options: development, testing, staging, production
DEBUG=true
API_V1_STR="/api/v1"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
LOG_LEVEL="INFO"                       # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# CORS Origins (JSON string array of allowed frontend origin URLs)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Default local standalone instance URI
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="commerce_insights"

# Connection Pool & Driver Tuning
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000                # Server selection & socket timeout in milliseconds

# Optional Authentication (leave empty if local instance does not require auth)
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_AUTH_SOURCE="admin"

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Exposed to client-side bundle via the VITE_ prefix
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="Commerce Insights"
VITE_ENABLE_MOCK_FALLBACK=false        # Strict: do not simulate fake metrics; require backend

# ------------------------------------------------------------------------------
# Synthetic Data Generation & Benchmark Suite
# ------------------------------------------------------------------------------
SEED_BATCH_SIZE=5000
SEED_TARGET_CUSTOMERS=10000
SEED_TARGET_PRODUCTS=2000
SEED_TARGET_ORDERS=50000
SEED_RANDOM_SEED=42                    # Fixed seed for repeatable dataset generation
